{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SuperMark",
  "mainBinaryName": "SuperMark",
  "version": "0.3.5",
  "identifier": "app.markedit.rust",
  "build": {
    "frontendDist": "../packages/core-editor/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Untitled — SuperMark",
        "width": 960,
        "height": 680,
        "minWidth": 420,
        "minHeight": 300,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown Document",
        "description": "Markdown Text Document",
        "mimeType": "text/markdown"
      },
      {
        "ext": [
          "textpack"
        ],
        "name": "TextPack Archive",
        "description": "Compressed Markdown TextBundle",
        "mimeType": "application/x-textpack"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwNTVDOEU3NkI2MERFRjAKUldUdzNtQnI1OGhWZ0tjOW1LdUlHaDlNZ1g2c3J3bS9CZXhHWHVGSDFjbUFMVEJVdEt5SjM2S2oK",
      "endpoints": [
        "https://github.com/firegong/SuperMark/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
