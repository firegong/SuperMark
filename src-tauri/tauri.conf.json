{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkEdit",
  "version": "0.1.0",
  "identifier": "app.markedit.windows",
  "build": {
    "frontendDist": "../packages/core-editor/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Untitled — MarkEdit",
        "width": 960,
        "height": 680,
        "minWidth": 420,
        "minHeight": 300,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
